  },
  {
    "code": "pragma solidity ^0.8.0;",
    "startLine": 2,
    "endLine": 2,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 3,
    "endLine": 3,
    "event": "add"
  },
  {
    "code": "struct HourlyBond {\n}",
    "startLine": 4,
    "endLine": 5,
    "event": "add"
  },
  {
    "code": "uint256 amount;",
    "startLine": 5,
    "endLine": 5,
    "event": "add"
  },
  {
    "code": "uint256 yieldQuotientFP;",
    "startLine": 6,
    "endLine": 6,
    "event": "add"
  },
  {
    "code": "uint256 moduloHour;",
    "startLine": 7,
    "endLine": 7,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 9,
    "endLine": 9,
    "event": "add"
  },
  {
    "code": "abstract contract HourlyBondSubscriptionLending is BaseLending {\n}",
    "startLine": 10,
    "endLine": 11,
    "event": "add"
  },
  {
    "code": "struct HourlyBondMetadata {\n}",
    "startLine": 11,
    "endLine": 12,
    "event": "add"
  },
  {
    "code": "YieldAccumulator yieldAccumulator;",
    "startLine": 12,
    "endLine": 12,
    "event": "add"
  },
  {
    "code": "uint256 buyingSpeed;",
    "startLine": 13,
    "endLine": 13,
    "event": "add"
  },
  {
    "code": "uint256 withdrawingSpeed;",
    "startLine": 14,
    "endLine": 14,
    "event": "add"
  },
  {
    "code": "uint256 lastBought;",
    "startLine": 15,
    "endLine": 15,
    "event": "add"
  },
  {
    "code": "uint256 lastWithdrawn;",
    "startLine": 16,
    "endLine": 16,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 18,
    "endLine": 18,
    "event": "add"
  },
  {
    "code": "mapping(address => HourlyBondMetadata) hourlyBondMetadata;",
    "startLine": 19,
    "endLine": 19,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 20,
    "endLine": 20,
    "event": "add"
  },
  {
    "code": "// issuer => holder => bond record",
    "startLine": 21,
    "endLine": 21,
    "event": "add"
  },
  {
    "code": "mapping(address => mapping(address => HourlyBond)) public hourlyBondAccounts;",
    "startLine": 22,
    "endLine": 23,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 24,
    "endLine": 24,
    "event": "add"
  },
  {
    "code": "function calcCumulativeYieldFP( YieldAccumulator storage yieldAccumulator, uint256 timeDelta ) internal view returns (uint256 accumulatorFP) {\n}",
    "startLine": 25,
    "endLine": 29,
    "event": "add"
  },
  {
    "code": "uint256 secondsDelta = timeDelta % (1 hours);",
    "startLine": 29,
    "endLine": 29,
    "event": "add"
  },
  {
    "code": "// linearly interpolate interest for seconds",
    "startLine": 30,
    "endLine": 30,
    "event": "add"
  },
  {
    "code": "// accumulator * hourly_yield == seconds_per_hour * accumulator * hourly_yield / seconds_per_hour",
    "startLine": 31,
    "endLine": 31,
    "event": "add"
  },
  {
    "code": "// FP * FP * 1 / (FP * 1) = FP",
    "startLine": 32,
    "endLine": 32,
    "event": "add"
  },
  {
    "code": "accumulatorFP = (yieldAccumulator.accumulatorFP * yieldAccumulator.hourlyYieldFP * secondsDelta) / (FP32 * 1 hours);",
    "startLine": 33,
    "endLine": 37,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 38,
    "endLine": 38,
    "event": "add"
  },
  {
    "code": "uint256 hoursDelta = timeDelta / (1 hours);",
    "startLine": 39,
    "endLine": 39,
    "event": "add"
  },
  {
    "code": "if (hoursDelta > 0) {\n}",
    "startLine": 40,
    "endLine": 41,
    "event": "add"
  },
  {
    "code": "// This loop should hardly ever 1 or more unless something bad happened",
    "startLine": 41,
    "endLine": 41,
    "event": "add"
  },
  {
    "code": "// In which case it costs gas but there isn't overflow",
    "startLine": 42,
    "endLine": 42,
    "event": "add"
  },
  {
    "code": "for (uint256 i = 0; hoursDelta > i; i++) {\n}",
    "startLine": 43,
    "endLine": 44,
    "event": "add"
  },
  {
    "code": "// FP32 * FP32 / FP32 = FP32",
    "startLine": 44,
    "endLine": 44,
    "event": "add"
  },
  {
    "code": "accumulatorFP = (accumulatorFP * yieldAccumulator.hourlyYieldFP) / FP32;",
    "startLine": 45,
    "endLine": 47,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 51,
    "endLine": 51,
    "event": "add"
  },
  {
    "code": "function viewCumulativeYieldFP( YieldAccumulator storage yA, uint256 timestamp ) internal view returns (uint256) {\n}",
    "startLine": 52,
    "endLine": 56,
    "event": "add"
  },
  {
    "code": "uint256 timeDelta = (timestamp - yA.lastUpdated);",
    "startLine": 56,
    "endLine": 56,
    "event": "add"
  },
  {
    "code": "return calcCumulativeYieldFP(yA, timeDelta);",
    "startLine": 57,
    "endLine": 57,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 59,
    "endLine": 59,
    "event": "add"
  },
  {
    "code": "// Retrieves bond balance for issuer and holder",
    "startLine": 60,
    "endLine": 60,
    "event": "add"
  },
  {
    "code": "function viewHourlyBondAmount(address issuer, address holder) public view returns (uint256) {\n}",
    "startLine": 61,
    "endLine": 66,
    "event": "add"
  },
  {
    "code": "HourlyBond storage bond = hourlyBondAccounts[issuer][holder];",
    "startLine": 66,
    "endLine": 66,
    "event": "add"
  },
  {
    "code": "uint256 yieldQuotientFP = bond.yieldQuotientFP;",
    "startLine": 67,
    "endLine": 67,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 68,
    "endLine": 68,
    "event": "add"
  },
  {
    "code": "uint256 cumulativeYield = viewCumulativeYieldFP( hourlyBondMetadata[issuer].yieldAccumulator, block.timestamp );",
    "startLine": 69,
    "endLine": 73,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 74,
    "endLine": 74,
    "event": "add"
  },
  {
    "code": "if (yieldQuotientFP > 0) {\n}",
    "startLine": 75,
    "endLine": 76,
    "event": "add"
  },
  {
    "code": "return bond.amount + applyInterest(bond.amount, cumulativeYield, yieldQuotientFP);",
    "startLine": 76,
    "endLine": 78,
    "event": "add"
  },
  {
    "code": "// @Post returnExpression == (bond.amount * cumulativeYield) / yieldQuotientFP",
    "startLine": 79,
    "endLine": 79,
    "event": "add"
  },
  {
    "code": "return bond.amount + 0;",
    "startLine": 81,
    "endLine": 81,
    "event": "add"
  },
