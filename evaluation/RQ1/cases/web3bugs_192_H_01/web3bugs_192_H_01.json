  },
  {
    "code": "IBondNFT public immutable bondNFT;",
    "startLine": 4,
    "endLine": 4,
    "event": "add"
  },
  {
    "code": "IGovNFT public immutable govNFT;",
    "startLine": 5,
    "endLine": 5,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 6,
    "endLine": 6,
    "event": "add"
  },
  {
    "code": "mapping(address => uint) public totalLocked;",
    "startLine": 7,
    "endLine": 7,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 8,
    "endLine": 8,
