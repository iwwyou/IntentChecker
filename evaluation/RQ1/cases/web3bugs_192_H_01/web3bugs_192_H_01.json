  },
  {
    "code": "/** * @notice Claim rewards from gov nfts and distribute them to bonds */ function claimGovFees() public {\n}",
    "startLine": 9,
    "endLine": 13,
    "event": "add"
  },
  {
    "code": "address[] memory assets = bondNFT.getAssets();",
    "startLine": 13,
    "endLine": 13,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 14,
    "endLine": 14,
    "event": "add"
  },
  {
    "code": "for (uint i=0; i < assets.length; i++) {\n}",
    "startLine": 15,
    "endLine": 16,
    "event": "add"
  },
  {
    "code": "uint balanceBefore = IERC20(assets[i]).balanceOf(address(this));",
    "startLine": 16,
    "endLine": 16,
    "event": "add"
  },
  {
    "code": "IGovNFT(govNFT).claim(assets[i]);",
    "startLine": 17,
    "endLine": 17,
    "event": "add"
  },
  {
    "code": "uint balanceAfter = IERC20(assets[i]).balanceOf(address(this));",
    "startLine": 18,
    "endLine": 18,
    "event": "add"
  },
  {
    "code": "IERC20(assets[i]).approve(address(bondNFT), type(uint256).max);",
    "startLine": 19,
    "endLine": 19,
    "event": "add"
  },
  {
    "code": "bondNFT.distribute(assets[i], balanceAfter - balanceBefore);",
    "startLine": 20,
    "endLine": 20,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 23,
    "endLine": 23,
    "event": "add"
  },
  {
    "code": "function claim( uint256 _id ) public returns (address) {\n}",
    "startLine": 24,
    "endLine": 27,
    "event": "add"
  },
  {
    "code": "claimGovFees();",
    "startLine": 27,
    "endLine": 27,
    "event": "add"
  },
  {
    "code": "(uint _amount, address _tigAsset) = bondNFT.claim(_id, msg.sender);",
    "startLine": 28,
    "endLine": 28,
    "event": "add"
  },
  {
    "code": "IERC20(_tigAsset).transfer(msg.sender, _amount);",
    "startLine": 29,
    "endLine": 29,
    "event": "add"
  },
  {
    "code": "return _tigAsset;",
    "startLine": 30,
    "endLine": 30,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 32,
    "endLine": 32,
    "event": "add"
  },
  {
    "code": "/** * @notice Reset the lock time and extend the period and/or token amount * @param _id Bond id being extended * @param _amount tigAsset amount being added * @param _period number of days being added */ function extendLock( uint _id, uint _amount, uint _period ) public {\n}",
    "startLine": 33,
    "endLine": 44,
    "event": "add"
  },
  {
    "code": "address _asset = claim(_id);",
    "startLine": 44,
    "endLine": 44,
    "event": "add"
  },
  {
    "code": "IERC20(_asset).transferFrom(msg.sender, address(this), _amount);",
    "startLine": 45,
    "endLine": 45,
    "event": "add"
  },
  {
    "code": "bondNFT.extendLock(_id, _asset, _amount, _period, msg.sender);",
    "startLine": 46,
    "endLine": 46,
    "event": "add"
  },
