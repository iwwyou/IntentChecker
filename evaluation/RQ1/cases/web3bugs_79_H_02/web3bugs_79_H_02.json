  {
    "code": "function currentPhase() public view returns (uint8) {\n}",
    "startLine": 83,
    "endLine": 84,
    "event": "add"
  },
  {
    "code": "if (block.timestamp < auctionStart || auctionStart == 0) {\n}",
    "startLine": 84,
    "endLine": 85,
    "event": "add"
  },
  {
    "code": "return PHASE_NOT_STARTED;",
    "startLine": 85,
    "endLine": 85,
    "event": "add"
  },
  {
    "code": "else if (block.timestamp < auctionStart + PHASE_ONE_DURATION) {\n}",
    "startLine": 86,
    "endLine": 87,
    "event": "add",
    "closeBefore": true
  },
  {
    "code": "return PHASE_ONE;",
    "startLine": 87,
    "endLine": 87,
    "event": "add"
  },
  {
    "code": "else if ( block.timestamp < auctionStart + PHASE_ONE_DURATION + PHASE_TWO_DURATION ) {\n}",
    "startLine": 88,
    "endLine": 92,
    "event": "add",
    "closeBefore": true
  },
  {
    "code": "return PHASE_TWO;",
    "startLine": 92,
    "endLine": 92,
    "event": "add"
  },
  {
    "code": "return PHASE_THREE;",
    "startLine": 94,
    "endLine": 94,
    "event": "add"
  },
