  },
  {
    "code": "function _atPhase(uint8 _phase) internal view {\n}",
    "startLine": 97,
    "endLine": 98,
    "event": "add"
  },
  {
    "code": "if (_phase == PHASE_NOT_STARTED) {\n}",
    "startLine": 98,
    "endLine": 99,
    "event": "add"
  },
  {
    "code": "require( currentPhase() == PHASE_NOT_STARTED, \"LaunchEvent: not in not started\" );",
    "startLine": 99,
    "endLine": 102,
    "event": "add"
  },
  {
    "code": "else if (_phase == PHASE_ONE) {\n}",
    "startLine": 103,
    "endLine": 104,
    "event": "add",
    "closeBefore": true
  },
  {
    "code": "require( currentPhase() == PHASE_ONE, \"LaunchEvent: not in phase one\" );",
    "startLine": 104,
    "endLine": 107,
    "event": "add"
  },
  {
    "code": "else if (_phase == PHASE_TWO) {\n}",
    "startLine": 108,
    "endLine": 109,
    "event": "add",
    "closeBefore": true
  },
  {
    "code": "require( currentPhase() == PHASE_TWO, \"LaunchEvent: not in phase two\" );",
    "startLine": 109,
    "endLine": 112,
    "event": "add"
  },
  {
    "code": "else if (_phase == PHASE_THREE) {\n}",
    "startLine": 113,
    "endLine": 114,
    "event": "add",
    "closeBefore": true
  },
  {
    "code": "require( currentPhase() == PHASE_THREE, \"LaunchEvent: not in phase three\" );",
    "startLine": 114,
    "endLine": 117,
    "event": "add"
  },
  {
    "code": "else {\n}",
    "startLine": 118,
    "endLine": 119,
    "event": "add",
    "closeBefore": true
  },
  {
    "code": "revert(\"LaunchEvent: unknown state\");",
    "startLine": 119,
    "endLine": 119,
    "event": "add"
  },
