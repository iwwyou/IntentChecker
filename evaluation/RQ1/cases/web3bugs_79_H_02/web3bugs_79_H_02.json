  {
    "code": "tokenAllocated = (wavaxReserve * 10**token.decimals()) / floorPrice;",
    "startLine": 157,
    "endLine": 157,
    "event": "add"
  },
  {
    "code": "tokenIncentivesForUsers = (tokenIncentivesForUsers * tokenAllocated) / tokenReserve;",
    "startLine": 158,
    "endLine": 160,
    "event": "add"
  },
  {
